{
  "name": "flux-foundry",
  "version": "0.28.0",
  "private": true,
  "description": "A tactile single-ball portrait ricochet game with realistic physics and numbered durability",
  "author": "ax2",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/service-worker.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "electron .",
    "package:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "test:play": "node scripts/paddle-play.mjs",
    "test:endurance": "tsx scripts/arcade-endurance.ts",
    "test:loading": "node scripts/loading-test.mjs",
    "test:active": "tsx scripts/active-endurance.ts",
    "test:full": "tsx scripts/full-endurance.ts",
    "test:expedition": "tsx scripts/endless-audit.ts",
    "test:varied": "tsx scripts/varied-endurance.ts",
    "test:sparse": "tsx scripts/sparse-endurance.ts",
    "test:multi": "tsx scripts/multi-endurance.ts",
    "test:feedback": "node scripts/feedback-test.mjs",
    "test:touch": "tsx scripts/replay-touch-inputs.ts",
    "test:residual": "tsx scripts/replay-varied-residual.ts",
    "test:update": "node scripts/update-test.mjs",
    "test:edge": "tsx scripts/replay-edge-route.ts",
    "test:balance": "node scripts/compare-wind-balance.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "8.3.6",
    "tsx": "^4.20.6",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0"
  },
  "build": {
    "appId": "com.zicode.fluxfoundry",
    "productName": "Flux Foundry",
    "directories": {
      "output": "releases/v${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Flux-Foundry-${version}-Windows-x64.exe"
    }
  }
}
